#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform PC { ivec2 inputSize; } pc;
layout(binding = 3, rgba16f) uniform writeonly image2D outImg;
ivec2 kiCoord(vec2 off) {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy) + ivec2(off);
    return clamp(p, ivec2(0), pc.inputSize - 1);
}
layout(binding = 0) uniform sampler2D MODEL1;
vec4 MODEL1_texOff(vec2 off) { return texelFetch(MODEL1, kiCoord(off), 0); }
layout(binding = 1) uniform sampler2D MODEL2;
vec4 MODEL2_texOff(vec2 off) { return texelFetch(MODEL2, kiCoord(off), 0); }
layout(binding = 2) uniform sampler2D FEATURE2;
vec4 FEATURE2_texOff(vec2 off) { return texelFetch(FEATURE2, kiCoord(off), 0); }
vec4 hookPass()
{
vec4 res = vec4(-0.0238974337,-0.3896386325,-0.0188582558,-0.2770469487);
res += mat4(0.0909820274,0.0769533738,-0.0366332494,-0.0167208239,0.0059926058,-0.4557324648,-0.2719854116,-0.1270634681,-0.0830126330,-0.1915322393,-0.0294343103,-0.2482964993,-0.0245691948,-0.1925931573,-0.0254294258,-0.5070286989) * MODEL1_texOff(vec2(0.0));
res += mat4(0.4616684020,0.0840959996,0.0183625259,0.0848913193,-0.0120586036,-0.6106212139,0.1646659374,-0.1671082526,-0.1588566601,-0.2087446302,-0.0347691849,-0.1632242054,0.0488674976,-0.3934296370,0.3045699894,0.2287159115) * MODEL2_texOff(vec2(0.0));
res += FEATURE2_texOff(vec2(0.0));
res = max(res, vec4(0.0)) + vec4(0.2362199426,0.0793651640,0.5939151645,0.0971795171) * min(res, vec4(0.0));
return res;
}
void main() {
    if (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), pc.inputSize))) return;
    imageStore(outImg, ivec2(gl_GlobalInvocationID.xy), hookPass());
}
