#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform PC { ivec2 inputSize; } pc;
layout(binding = 3, rgba16f) uniform writeonly image2D outImg;
ivec2 kiCoord(vec2 off) {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy) + ivec2(off);
    return clamp(p, ivec2(0), pc.inputSize - 1);
}
layout(binding = 0) uniform sampler2D MODEL1;
vec4 MODEL1_texOff(vec2 off) { return texelFetch(MODEL1, kiCoord(off), 0); }
layout(binding = 1) uniform sampler2D MODEL2;
vec4 MODEL2_texOff(vec2 off) { return texelFetch(MODEL2, kiCoord(off), 0); }
layout(binding = 2) uniform sampler2D FEATURE1;
vec4 FEATURE1_texOff(vec2 off) { return texelFetch(FEATURE1, kiCoord(off), 0); }
vec4 hookPass()
{
vec4 res = vec4(0.0223633870,-0.4610109031,0.0170850027,-0.0128523186);
res += mat4(0.0444359109,-0.7458050251,-0.1230981424,-0.0499671660,0.2274357527,0.0920760930,-0.0262026768,-0.4388726950,0.0668949112,-0.3411522508,0.0368165150,-0.0653901249,-0.0638170317,-0.8309959173,0.0789229572,0.1219522581) * MODEL1_texOff(vec2(0.0));
res += mat4(-0.0671297163,0.1332720369,0.0066167745,0.1236628294,-0.0007678999,-0.1864669025,0.0217455812,0.0071432255,0.0710315555,-0.2916274965,0.1308876872,-0.1055090800,-0.0001874833,0.1919683367,-0.0368141904,-0.1035963967) * MODEL2_texOff(vec2(0.0));
res += FEATURE1_texOff(vec2(0.0));
res = max(res, vec4(0.0)) + vec4(0.9965294600,0.0424302220,1.2801862955,1.0034425259) * min(res, vec4(0.0));
return res;
}
void main() {
    if (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), pc.inputSize))) return;
    imageStore(outImg, ivec2(gl_GlobalInvocationID.xy), hookPass());
}
